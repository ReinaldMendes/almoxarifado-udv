# Banco (Railway PostgreSQL → copie a DATABASE_URL do plugin)
DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# Segurança
JWT_SECRET="troque-por-uma-string-aleatoria-de-32+-caracteres"
IP_HASH_SALT="troque-por-outra-string-aleatoria"

# Servidor
PORT=4000
NODE_ENV=development
# URL(s) do front permitidas no CORS, separadas por vírgula
CORS_ORIGINS="http://localhost:3000"
# Quantos proxies existem na frente da API (Vercel rewrite + Railway = 2)
TRUST_PROXY_HOPS=2

# Seed (usuário ADMIN inicial)
SEED_ADMIN_EMAIL="admin@udv-pg.local"
SEED_ADMIN_PASSWORD="troque-esta-senha-123"
SEED_SAMPLE_DATA=true
